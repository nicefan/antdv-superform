{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "paths": {
      "superform": ["../../src/index.ts"],
      "superform/sdk": ["../../src/sdk.ts"],
      "superform/unplugin/vite": ["../../src/unplugin/vite.ts"],
      "src/*": ["../../src/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "../../src/adapter/types.ts"]
}
