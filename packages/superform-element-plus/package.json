{
  "name": "superform-element-plus",
  "version": "1.0.0",
  "description": "Element Plus adapter for SuperForm",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./full": {
      "types": "./lib/full.d.ts",
      "import": "./lib/full.js"
    },
    "./unplugin": {
      "types": "./lib/unplugin.d.ts",
      "import": "./lib/unplugin.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build"
  },
  "peerDependencies": {
    "element-plus": ">=2.14.5",
    "superform": ">=1.0.0",
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "element-plus": "^2.14.5",
    "superform": "workspace:*",
    "typescript": "~5.3.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "vue": "~3.5.41",
    "vue-tsc": "^1.8.20"
  }
}
