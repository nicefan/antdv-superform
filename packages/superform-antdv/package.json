{
  "name": "superform-antdv",
  "version": "1.0.0",
  "description": "AntDV adapter for SuperForm",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": ["lib"],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./full": {
      "types": "./lib/full.d.ts",
      "import": "./lib/full.js"
    },
    "./unplugin": {
      "types": "./lib/unplugin.d.ts",
      "import": "./lib/unplugin.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@antdv-next/icons": ">=1.1.1",
    "antdv-next": ">=1.5.0",
    "superform": ">=1.0.0",
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@antdv-next/icons": "1.1.1",
    "@types/node": "^18.18.6",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "superform": "workspace:*",
    "typescript": "~5.3.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "vue": "~3.5.41",
    "vue-tsc": "^1.8.20"
  }
}
