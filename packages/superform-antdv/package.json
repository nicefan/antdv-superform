{
  "name": "superform-antdv",
  "version": "1.0.0",
  "description": "SuperForm for AntDV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicefan/antdv-superform.git",
    "directory": "packages/superform-antdv"
  },
  "homepage": "https://nicefan.github.io/antdv-superform/",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": ["lib"],
  "sideEffects": ["./lib/style.css"],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./components": {
      "types": "./lib/components.d.ts",
      "import": "./lib/components.js"
    },
    "./unplugin": {
      "types": "./lib/unplugin.d.ts",
      "import": "./lib/unplugin.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "@antdv-next/icons": ">=1.1.1",
    "antdv-next": ">=1.5.0",
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@antdv-next/icons": "1.1.1",
    "@types/node": "^18.18.6",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "superform": "workspace:*",
    "typescript": "~5.3.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "vue": "~3.5.41",
    "vue-tsc": "^1.8.20"
  }
}
