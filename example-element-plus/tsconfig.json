{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "superform": ["../src/index.ts"],
      "superform/sdk": ["../src/sdk.ts"],
      "superform/unplugin/vite": ["../src/unplugin/vite.ts"],
      "superform-element-plus": ["../packages/superform-element-plus/src/index.ts"],
      "superform-element-plus/unplugin": ["../packages/superform-element-plus/src/unplugin.ts"],
      "src/*": ["../src/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["*.ts", "*.d.ts", "*.vue"]
}
