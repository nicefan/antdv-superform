{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "superform": ["../src/index.ts"],
      "superform/sdk": ["../src/sdk.ts"],
      "superform/unplugin/vite": ["../src/unplugin/vite.ts"],
      "superform-antdv": ["../packages/superform-antdv/src/index.ts"],
      "superform-antdv/unplugin": ["../packages/superform-antdv/src/unplugin.ts"],
      "src/*": ["../src/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.tsx", "**/*.vue"],
  "exclude": ["node_modules"]
}
