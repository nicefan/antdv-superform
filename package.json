{
  "name": "superform",
  "version": "1.0.0",
  "author": {
    "name": "nicefan",
    "email": "covien@msn.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicefan/antdv-superform.git"
  },
  "homepage": "https://nicefan.github.io/antdv-superform/",
  "license": "MIT",
  "files": [
    "bin",
    "shared",
    "lib",
    "types",
    "index.d.ts",
    "AI_GUIDE.md"
  ],
  "bin": {
    "superform": "bin/antdv-superform.mjs"
  },
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./unplugin/vite": {
      "types": "./lib/vite.d.ts",
      "import": "./lib/unplugin/vite.js"
    },
    "./sdk": {
      "types": "./lib/sdk.d.ts",
      "import": "./lib/sdk.js"
    }
  },
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "build:core": "vue-tsc --noEmit && vite build",
    "build": "pnpm run build:core && pnpm --filter superform-antdv build && pnpm --filter superform-element-plus build",
    "build:examples": "pnpm --filter superform-antdv-example build && pnpm --filter superform-element-plus-example build",
    "test": "vitest run",
    "build:dist": "vite build --mode dist",
    "rollup": "rollup -c",
    "dts": "vue-tsc --declaration --emitDeclarationOnly"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@antdv-next/icons": "1.1.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/lodash-es": "^4.17.10",
    "@types/node": "^18.18.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/compiler-sfc": "~3.5.41",
    "@vue/runtime-core": "~3.5.41",
    "@vueuse/core": "^10.5.0",
    "antdv-next": "1.5.0",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.5",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.17.0",
    "less": "^4.2.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^4.0.2",
    "prettier": "^2.8.8",
    "rollup": "^3.29.4",
    "rollup-plugin-dts": "^5.3.1",
    "rollup-plugin-esbuild": "^5.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue-jsx-compat": "^0.0.6",
    "sass": "^1.69.4",
    "tslib": "^2.8.1",
    "typescript": "~5.3.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.6.0",
    "vite-svg-symbol-loader": "^1.0.0",
    "vitest": "^0.29.8",
    "vue": "~3.5.41",
    "vue-tsc": "^1.8.20"
  }
}
